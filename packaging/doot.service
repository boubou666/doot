# Unite systemd utilisateur (modele).
# install.sh en genere automatiquement une version avec les bons chemins dans
# ~/.config/systemd/user/doot.service. Ce fichier sert de reference si tu
# preferes l'ecrire a la main :
#
#   cp packaging/doot.service ~/.config/systemd/user/doot.service
#   $EDITOR ~/.config/systemd/user/doot.service   # ajuste ExecStart
#   systemctl --user daemon-reload
#   systemctl --user enable --now doot.service

[Unit]
Description=doot - squelette trompettiste saisonnier
# Surtout pas default.target : il demarre avec le gestionnaire utilisateur,
# avant que la session ne publie DISPLAY et WAYLAND_DISPLAY. Sous Plasma,
# remplacer les deux lignes par plasma-workspace.target, que la publication de
# ces variables accompagne.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Ajoute --burst-min 2 --burst-max 5 pour enchainer plusieurs doots par
# declenchement. Attention : install.sh reecrit ce fichier a chaque mise a
# jour, et le regenere depuis install.json. Pour que le reglage tienne, le
# passer plutot a l'installeur : ./install.sh --burst-min 2 --burst-max 5
ExecStart=%h/.local/bin/doot --min 600 --max 3600 --quiet
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
